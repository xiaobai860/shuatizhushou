# —— Android / Gradle 构建产物 ——
*.iml
.gradle/
build/
app/build/
**/build/
# release 变体输出（不在 app/build/ 下，独立于上述规则）
app/release/
captures/
.externalNativeBuild/
.cxx/

# —— 本地配置（含 SDK 路径，不同设备不同，勿入库） ——
local.properties
gradle.properties.local

# —— IDE ——
*.idea/
*.iws
*.ipr
.DS_Store
Thumbs.db
~$*

# —— 运行/调试输出 ——
*.log
*.hprof
*.apk
*.aar
output.json

# —— Kotlin 编译器运行时产物（K2 官方推荐忽略：会话存活标记/守护进程日志等，纯本机瞬时文件） ——
.kotlin/

# —— 本地工作记忆（迁移代码仓库不需要） ——
.codebuddy/
build_log.txt

# —— Gradle Daemon JVM 配置（本地可再生；且固定版本会与 IDE 实际 JDK 冲突） ——
gradle/gradle-daemon-jvm.properties

# —— Android SDK 工具目录（体积大，不入库） ——
sdktools/

# —— 密钥/签名（若有） ——
*.jks
*.keystore
signing.properties

# —— WorkBuddy 本地数据（记忆/会话缓存，勿入库） ——
.workbuddy/

# —— 设计交付产物（原型/规范可据 .impeccable.md 与代码重现） ——
outputs/
